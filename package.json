{
  "name": "startpage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && stylelint \"src/**/*.scss\"",
    "preview": "vite preview",
    "zip": "pnpm build && cd dist && zip -qr ../startpage-extension.zip . && echo 'Packed: startpage-extension.zip'",
    "icons:sync": "node scripts/sync-itab-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "sass-embedded": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@10.15.1"
}
